---
import wechatIcon from '@tabler/icons/outline/brand-wechat.svg?raw';
import closeIcon from '@tabler/icons/outline/x.svg?raw';
import { copy, profile, type Locale } from '../data/profile';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<a class="contact-icon" href={profile.wechatQr} aria-label={t.wechatContact} title={t.wechatContact} data-wechat-open>
  <span aria-hidden="true" set:html={wechatIcon} />
</a>

<dialog id="wechat-dialog" class="wechat-dialog" aria-labelledby="wechat-title">
  <div class="wechat-panel">
    <div class="wechat-header">
      <h2 id="wechat-title">{t.wechatTitle}</h2>
      <form method="dialog">
        <button class="wechat-close" aria-label={t.wechatClose} title={t.wechatClose} autofocus>
          <span aria-hidden="true" set:html={closeIcon} />
        </button>
      </form>
    </div>
    <img class="wechat-qr" src={profile.wechatQr} alt={t.wechatQrAlt} width="888" height="1191" loading="lazy" decoding="async" />
    <a class="wechat-original" href={profile.wechatQr} target="_blank" rel="noopener noreferrer">{t.wechatOpenImage}</a>
  </div>
</dialog>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>('[data-wechat-open]');
  const dialog = document.querySelector<HTMLDialogElement>('#wechat-dialog');

  // Keep the original-image link usable without JavaScript or native dialogs.
  if (trigger && dialog && typeof dialog.showModal === 'function') {
    trigger.setAttribute('role', 'button');
    trigger.setAttribute('aria-haspopup', 'dialog');
    trigger.setAttribute('aria-controls', dialog.id);
    trigger.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
    });
    trigger.addEventListener('keydown', event => {
      if (event.key === ' ') {
        event.preventDefault();
        trigger.click();
      }
    });
    dialog.addEventListener('keydown', event => {
      if (event.key !== 'Tab' || event.ctrlKey || event.metaKey || event.altKey) return;
      const closeButton = dialog.querySelector<HTMLButtonElement>('.wechat-close');
      const imageLink = dialog.querySelector<HTMLAnchorElement>('.wechat-original');
      // Native dialogs can otherwise send focus to browser chrome at the edges.
      if (event.shiftKey && document.activeElement === closeButton) {
        event.preventDefault();
        imageLink?.focus();
      } else if (!event.shiftKey && document.activeElement === imageLink) {
        event.preventDefault();
        closeButton?.focus();
      }
    });
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
        dialog.close();
      }
    });
  }
</script>

<style>
  :global(html:has(#wechat-dialog[open])) { overflow: hidden; }
  .wechat-dialog {
    width: min(420px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 20px;
    border: 1px solid var(--strong-line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--body);
    overscroll-behavior: contain;
  }
  .wechat-dialog::backdrop { background: rgb(7 9 15 / 65%); }
  .wechat-panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .wechat-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .wechat-header h2 { font-size: 1.5rem; }
  .wechat-header form { margin: 0; }
  .wechat-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--strong-line);
    border-radius: 50%;
    background: transparent;
    color: var(--link);
    cursor: pointer;
  }
  .wechat-close:hover { background: var(--surface); border-color: var(--link); }
  .wechat-close :global(svg) { width: 22px; height: 22px; }
  .wechat-qr {
    justify-self: center;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 192px);
    object-fit: contain;
    background: white;
  }
  .wechat-original { display: flex; align-items: center; justify-content: center; min-height: 44px; font-size: 0.875rem; }

  @media (min-width: 600px) and (max-height: 540px) {
    .wechat-dialog { width: min(640px, calc(100% - 32px)); }
    .wechat-panel { grid-template-columns: minmax(0, 1fr) 220px; align-items: center; column-gap: 24px; }
    .wechat-header { grid-column: 2; }
    .wechat-qr { grid-column: 1; grid-row: 1 / 3; max-height: calc(100dvh - 76px); }
    .wechat-original { grid-column: 2; align-self: start; }
  }
</style>
