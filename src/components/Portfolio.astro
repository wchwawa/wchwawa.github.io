---
import chevronDownIcon from '@tabler/icons/outline/chevron-down.svg?raw';
import { articles, biography, copy, type Locale } from '../data/profile';
import { cvCopy, education, experience, monthLabel, recognition, skills } from '../data/cv';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const cv = cvCopy[locale];
const speaking = recognition.copy[locale];
---
<div class="resume-layout shell">
  <main id="main" class="resume-content" tabindex="-1">

  <section id="about" class="section about-section" aria-labelledby="about-title">
    <h2 id="about-title" class="section-heading">{t.about}</h2>
    <div class="biography">
      {biography[locale].map(paragraph => <p>{paragraph.map(segment => segment.href ? <a href={segment.href}>{segment.text}</a> : segment.text)}</p>)}
    </div>
  </section>

  <section id="experience" class="section experience-section" aria-labelledby="experience-title">
    <span id="work" class="anchor-alias" aria-hidden="true"></span>
    <h2 id="experience-title" class="section-heading">{cv.experience}</h2>
    <ol class="timeline" aria-label={cv.timelineLabel}>
      {experience.map((entry, index) => {
        const item = entry.copy[locale];
        return (
          <li class:list={['timeline-entry', { 'timeline-latest': index === 0 }]} data-experience={entry.id} data-kind={entry.kind} data-project={entry.projectId}>
            <span class="timeline-dot" aria-hidden="true"></span>
            <div class="timeline-date">
              <time datetime={entry.start}>{monthLabel(entry.start)}</time>
              {entry.end !== entry.start && <span class="timeline-end">{entry.end ? <>{cv.to}{' '}<time datetime={entry.end}>{monthLabel(entry.end)}</time></> : entry.incoming ? cv.incoming : cv.present}</span>}
            </div>
            <article class="timeline-body" aria-labelledby={`experience-${entry.id}`}>
              <div class:list={['experience-heading', { 'experience-heading-only': !item.summary }]}>
                <h3 id={`experience-${entry.id}`}><a href={entry.url}>{item.name}</a></h3>
                <p class="experience-role">{item.role}</p>
              </div>
              {item.summary && <details class="experience-details">
                <summary aria-label={`${item.name}: ${cv.details}`}>
                  <span class="experience-summary">{item.summary}</span>
                  <span class="experience-toggle" aria-hidden="true" set:html={chevronDownIcon} />
                </summary>
                {item.outcome && <p class="experience-outcome">{item.outcome}</p>}
              </details>}
            </article>
          </li>
        );
      })}
    </ol>
  </section>

  <section id="education" class="section education-section" aria-labelledby="education-title">
    <h2 id="education-title" class="section-heading">{cv.education}</h2>
    <div class="education-list">{education.map(entry => (
      <article class="education-entry">
        <div><h3>{entry.copy[locale].institution}</h3><p>{entry.copy[locale].degree}</p></div>
        <p class="education-date"><time datetime={entry.start}>{monthLabel(entry.start)}</time>{' - '}<time datetime={entry.end}>{monthLabel(entry.end)}</time></p>
      </article>
    ))}</div>
  </section>

  <section id="skills" class="section skills-section" aria-labelledby="skills-title">
    <h2 id="skills-title" class="section-heading">{cv.skills}</h2>
    <dl class="skills-list">{skills[locale].map(skill => <div><dt>{skill.label}</dt><dd>{skill.text}</dd></div>)}</dl>
  </section>

  <section id="speaking" class="section speaking-section" aria-labelledby="speaking-title">
    <h2 id="speaking-title" class="section-heading">{cv.recognition}</h2>
    <article class="speaking-entry">
      <time datetime={recognition.date}>{monthLabel(recognition.date)}</time>
      <div><h3>{speaking.title}</h3><p class="experience-role">{speaking.role}</p><p>{speaking.text}</p></div>
    </article>
  </section>

  <section id="writing" class="section writing-section" aria-labelledby="writing-title">
    <h2 id="writing-title" class="section-heading">{t.writing}</h2>
    <div class="writing-list">
      {articles.map(article => {
        const a = article.copy[locale];
        return (
          <article class="writing-entry">
            <time datetime={article.published}>{monthLabel(article.published.slice(0, 7))}</time>
            <h3><a href={article.url}>{a.title}<span class="external-arrow" aria-hidden="true">↗</span></a></h3>
          </article>
        );
      })}
    </div>
  </section>

  </main>
</div>
