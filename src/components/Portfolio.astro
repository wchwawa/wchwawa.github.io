---
import { articles, copy, profile, projects, type Locale } from '../data/profile';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<main id="main" class="shell" tabindex="-1">
  <section class="hero" aria-labelledby="name">
    <div class="hero-copy">
      <p class="eyebrow">{t.location}</p>
      <h1 id="name">{profile.name}</h1>
      <p class="profession">{t.profession}</p>
      <p class="hero-introduction">{t.introduction}</p>
      <p class="hero-summary">{t.summary}</p>
      <div class="hero-actions">
        <a class="button button-solid" href="#contact">{t.contactAction}<span aria-hidden="true"> ↗</span></a>
        <a class="button button-outline" href={profile.cv} download="Jason_Wang_CV.pdf" data-cv-link>{t.cvAction}<span aria-hidden="true"> ↓</span></a>
        <span class="cv-note">{t.cvNote}</span>
      </div>
    </div>
    <figure class="portrait">
      <img src={profile.portrait} alt={t.portraitAlt} width="256" height="256" fetchpriority="high" />
      <figcaption>{t.portraitCaption}</figcaption>
    </figure>
  </section>

  <section id="work" class="section work-section" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">{t.projects}</h2>
      <p>{t.projectCount}</p>
    </div>
    <div class="project-list">
      {projects.map((project, index) => {
        const p = project.copy[locale];
        return (
          <article class="project" data-project={project.id} aria-labelledby={`project-${project.id}`}>
            <div class="project-identity">
              <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 id={`project-${project.id}`}><a href={project.url}>{project.name}<span class="external-arrow" aria-hidden="true">↗</span></a></h3>
                <p class="project-role">{p.role}</p>
              </div>
            </div>
            <div class="project-body">
              <p class="project-focus">{p.focus}</p>
              <p class="project-description">{p.description}</p>
              <p class="project-outcome">
                {p.outcome}
                {project.recognitionLinks && <>{' '}{project.recognitionLinks.map((link, linkIndex) => <>{linkIndex > 0 && <span aria-hidden="true"> · </span>}<a href={link.url}>{link.name}</a></>)}</>}
              </p>
              {p.note && <p class="project-note">{p.note}</p>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="about" class="section about-section" aria-labelledby="about-title">
    <p class="eyebrow">{t.about}</p>
    <h2 id="about-title">{t.aboutTitle}</h2>
    <div class="about-grid">
      <div class="about-story">{t.aboutParagraphs.map(paragraph => <p>{paragraph}</p>)}</div>
      <aside class="teaching" aria-labelledby="teaching-title">
        <p class="eyebrow">{t.teachingLabel}</p>
        <h3 id="teaching-title">{t.teachingTitle}</h3>
        <p>{t.teachingBody}</p>
      </aside>
    </div>
    <p class="principle">{t.principle}</p>
  </section>

  <section id="writing" class="section writing-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">{t.writing}</h2>
      <p>{t.writingDescription}</p>
    </div>
    <div class="writing-list">
      {articles.map(article => {
        const a = article.copy[locale];
        return (
          <article class="writing-entry">
            <time datetime={article.published}>{a.date}</time>
            <div>
              <h3><a href={article.url}>{a.title}<span class="external-arrow" aria-hidden="true">↗</span></a></h3>
              <p>{a.description}</p>
              <span class="article-destination">{t.readArticle}</span>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="contact" class="section contact-section" aria-labelledby="contact-title">
    <p class="eyebrow">{t.contact}</p>
    <h2 id="contact-title">{t.contactTitle}</h2>
    <p class="contact-description">{t.contactBody}</p>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true"> ↗</span></a>
    <div class="social-links">
      <a href={profile.github}>GitHub<span aria-hidden="true"> ↗</span></a>
      <a href={profile.linkedin}>LinkedIn<span aria-hidden="true"> ↗</span></a>
    </div>
  </section>
</main>
